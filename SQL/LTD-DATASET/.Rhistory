library(DBI)
library(RSQLite)
install.packages("DBI")
install.packages("RSQLite")
install.packages("RSQLite", dependencies = TRUE)
library(DBI)
library(RSQLite)
# Connect or create database
con <- dbConnect(RSQLite::SQLite(), "ltd_database.db")
# Read CSV
df <- read.csv("LTD.csv")
# Write CSV to table in SQLite
dbWriteTable(con, "LTD", df, overwrite = TRUE)
# Disconnect
dbDisconnect(con)
save.image("~/Desktop/PORTFOLIO/SQL/LTD-DATASET/CSV-DB.R.RData")
